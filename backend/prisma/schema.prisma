generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  name           String
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    TeamMember[]
  ownedTeams     Team[]       @relation("TeamOwner")
  sessions       Session[]
  auditLogs      AuditLog[]
  notifications  NotificationSetting[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Teams / Orgs ────────────────────────────────────────────────────────────

model Team {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  ownerId     String
  owner       User         @relation("TeamOwner", fields: [ownerId], references: [id])
  plan        String       @default("hobby") // hobby, pro, enterprise
  createdAt   DateTime     @default(now())

  members     TeamMember[]
  deployments Deployment[]
  auditLogs   AuditLog[]
  usageRecords UsageRecord[]
}

model TeamMember {
  id       String @id @default(uuid())
  role     String @default("member") // owner, admin, member
  teamId   String
  userId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
}

// ─── Deployments ─────────────────────────────────────────────────────────────

model Deployment {
  id          String   @id @default(uuid())
  gitUrl      String?
  name        String
  status      String   // pending, building, deploying, running, failed, stopped
  imageTag    String?
  liveUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  containerId String?
  port        Int?
  region      String   @default("us-east-1")

  // Resource type
  type        String   @default("app") // app, postgres, redis, worker, cron

  // PR Previews
  isPrPreview Boolean  @default(false)
  prNumber    Int?

  // Health Check (user-configurable)
  healthCheckPath     String  @default("/")
  healthCheckInterval Int     @default(30)
  healthCheckTimeout  Int     @default(5)

  // Auto-scaling
  minReplicas  Int  @default(1)
  maxReplicas  Int  @default(1)
  cpuThreshold Int  @default(80) // percent

  // Cron / Worker
  cronSchedule String?
  startCommand String?

  // Persistent disk
  diskSizeGb   Int?
  diskMountPath String?

  // Team
  teamId       String?
  team         Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)

  logs         Log[]
  envVars      EnvironmentVariable[]
  domains      CustomDomain[]
  disks        PersistentDisk[]
  scalingEvents ScalingEvent[]
}

model EnvironmentVariable {
  id           String     @id @default(uuid())
  key          String
  value        String     // AES-256 encrypted
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, key])
}

model CustomDomain {
  id           String     @id @default(uuid())
  domain       String     @unique
  verified     Boolean    @default(false)
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

model Log {
  id           String     @id @default(uuid())
  content      String
  level        String     @default("info") // info, warn, error
  createdAt    DateTime   @default(now())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

// ─── Persistent Disks ────────────────────────────────────────────────────────

model PersistentDisk {
  id           String     @id @default(uuid())
  name         String
  sizeGb       Int        @default(1)
  mountPath    String     @default("/data")
  volumeName   String     @unique
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

// ─── Auto-scaling ────────────────────────────────────────────────────────────

model ScalingEvent {
  id           String     @id @default(uuid())
  fromReplicas Int
  toReplicas   Int
  reason       String
  createdAt    DateTime   @default(now())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

// ─── Billing / Usage ─────────────────────────────────────────────────────────

model UsageRecord {
  id         String   @id @default(uuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  metric     String   // cpu_seconds, memory_gb_hours, bandwidth_gb
  value      Float
  recordedAt DateTime @default(now())
}

// ─── Audit Logs ──────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  action     String   // deployment.created, env.updated, domain.added, user.login, etc.
  entityType String   // deployment, team, user
  entityId   String
  metadata   String   // JSON string
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  teamId     String?
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

// ─── Notifications ───────────────────────────────────────────────────────────

model NotificationSetting {
  id            String  @id @default(uuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled  Boolean @default(true)
  slackWebhook  String?
  onSuccess     Boolean @default(true)
  onFailure     Boolean @default(true)
  onPrPreview   Boolean @default(true)

  @@unique([userId])
}
